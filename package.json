{
  "name": "llmitmproxy",
  "version": "0.1.0",
  "description": "A live viewer for the LLM calls your agents make, captured through mitmproxy.",
  "type": "module",
  "bin": {
    "llmitmproxy": "./bin/llmitmproxy"
  },
  "files": [
    "bin",
    "dist",
    "addon/mitmproxy_addon.py",
    "config"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node bin/llmitmproxy --dev",
    "build": "vite build",
    "start": "node bin/llmitmproxy",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "replay": "tsx scripts/replay.ts",
    "update-pricing": "tsx scripts/update-pricing.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "mitmproxy",
    "proxy",
    "claude",
    "claude-code",
    "openai",
    "anthropic",
    "gemini",
    "codex",
    "ai-agents",
    "observability",
    "debugging",
    "viewer"
  ],
  "license": "MIT",
  "author": "Armedi <armedi@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armedi/llmitmproxy.git"
  },
  "homepage": "https://github.com/armedi/llmitmproxy#readme",
  "bugs": {
    "url": "https://github.com/armedi/llmitmproxy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "srvx": "^1.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
