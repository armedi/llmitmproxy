{
  "name": "llmview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --hot server/index.ts",
    "proxy": "mitmdump -s addon/llmview_addon.py -p 8080 --set flow_detail=0",
    "proxy:web": "mitmweb -s addon/llmview_addon.py -p 8080",
    "replay": "bun scripts/replay.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
