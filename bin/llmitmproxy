#!/usr/bin/env node
import { existsSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { parseArgs } from "node:util";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const SERVER = resolve(ROOT, "dist/server/server.js");

function printHelp() {
  console.log(`Usage: llmitmproxy [start] [options]
       llmitmproxy addon-path

Commands:
  start          Start the UI server; imports what the addon captured (default)
  addon-path     Print the absolute path to the mitmproxy addon

Options for start:
  -p, --port <number>   Server port (default $PORT, else 3000)
      --host <address>  Bind address (default 127.0.0.1)
      --db <path>       Path to the SQLite database file (default ~/.llmitmproxy/llmitmproxy.db).
                        Start mitmproxy with LLMITMPROXY_DB set to the same path.
      --retention <age> Delete captures older than this, by request time: e.g. 12h, 7d, 2w,
                        or 0/off to keep them forever (default 7d)
      --dev             Run from source with hot reload (needs a checkout with dev dependencies)
  -h, --help            Show this help
`);
}

// node:sqlite, which stores the captures, needs no flag from these versions on.
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 13)) {
  console.error(`llmitmproxy needs Node.js 22.13 or newer (this is ${process.version})`);
  process.exit(1);
}

const [command, ...rest] = process.argv.slice(2);

if (command === "addon-path") {
  console.log(resolve(ROOT, "addon/mitmproxy_addon.py"));
} else if (command === "-h" || command === "--help") {
  printHelp();
} else {
  const argv = command === "start" ? rest : process.argv.slice(2);
  const { values } = parseArgs({
    args: argv,
    options: {
      port: { type: "string", short: "p" },
      host: { type: "string" },
      db: { type: "string" },
      retention: { type: "string" },
      dev: { type: "boolean" },
      help: { type: "boolean", short: "h" },
    },
    allowPositionals: false,
  });

  if (values.help) {
    printHelp();
    process.exit(0);
  }

  const opts = {
    port: values.port ? Number(values.port) : undefined,
    host: values.host,
    db: values.db ? resolve(process.cwd(), values.db) : undefined,
  };
  if (values.dev) await startDev(opts, values.retention);
  else await startBuilt(opts, values.retention);
}

function checkRetention(parseDuration, text) {
  const retention = text === undefined ? undefined : parseDuration(text);
  if (text !== undefined && retention === undefined) {
    console.error(`Invalid --retention "${text}": use e.g. 12h, 7d, 2w, or 0/off`);
    process.exit(1);
  }
  return retention;
}

/** The production server, on the build in dist/. */
async function startBuilt(opts, retentionText) {
  if (!existsSync(SERVER)) {
    console.error(`${SERVER} is missing: run \`npm run build\` first`);
    process.exit(1);
  }
  const { parseDuration, startServer } = await import(pathToFileURL(SERVER).href);
  await startServer({ ...opts, retention: checkRetention(parseDuration, retentionText) });
}

/** The Vite dev server on the source, with hot reload. */
async function startDev(opts, retentionText) {
  const vite = await import("vite").catch(() => null);
  if (!vite) {
    console.error("--dev runs from source: use a checkout of the repository with `npm install` done");
    process.exit(1);
  }
  const server = await vite.createServer({ root: ROOT, server: { port: opts.port, host: opts.host } });
  const { parseDuration } = await server.environments.ssr.runner.import("/src/backend.server.ts");
  checkRetention(parseDuration, retentionText);
  // The backend runs inside Vite's SSR module runner and reads its options from the environment.
  if (opts.db) process.env.LLMITMPROXY_DB = opts.db;
  if (opts.host) process.env.LLMITMPROXY_HOST = opts.host;
  if (retentionText) process.env.LLMITMPROXY_RETENTION = retentionText;
  await server.listen();
  server.printUrls();
}
