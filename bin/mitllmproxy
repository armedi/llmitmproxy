#!/usr/bin/env bun
import { resolve } from "node:path";
import { parseArgs } from "node:util";

const ROOT = resolve(import.meta.dir, "..");

function printHelp() {
  console.log(`Usage: mitllmproxy [start] [options]
       mitllmproxy addon-path

Commands:
  start          Start the UI server; imports what the addon captured (default)
  addon-path     Print the absolute path to the mitmproxy addon

Options for start:
  -p, --port <number>   Server port (default 4545)
      --host <address>  Bind address (default 127.0.0.1)
      --db <path>       Path to the SQLite database file (default ~/.mitllmproxy/mitllmproxy.db).
                        Start mitmproxy with MITLLMPROXY_DB set to the same path.
      --retention <age> Delete captures older than this, by request time: e.g. 12h, 7d, 2w,
                        or 0/off to keep them forever (default 7d)
      --dev             Enable hot reload / dev logging
  -h, --help            Show this help
`);
}

const [command, ...rest] = process.argv.slice(2);

if (command === "addon-path") {
  console.log(resolve(ROOT, "addon/mitllmproxy_addon.py"));
} else if (command === "-h" || command === "--help") {
  printHelp();
} else {
  const argv = command === "start" ? rest : process.argv.slice(2);
  const { values } = parseArgs({
    args: argv,
    options: {
      port: { type: "string", short: "p" },
      host: { type: "string" },
      db: { type: "string" },
      retention: { type: "string" },
      dev: { type: "boolean" },
      help: { type: "boolean", short: "h" },
    },
    allowPositionals: false,
  });

  if (values.help) {
    printHelp();
    process.exit(0);
  }

  const { parseDuration, startServer } = await import("../server/index.ts");
  const retention = values.retention === undefined ? undefined : parseDuration(values.retention);
  if (values.retention !== undefined && retention === undefined) {
    console.error(`Invalid --retention "${values.retention}": use e.g. 12h, 7d, 2w, or 0/off`);
    process.exit(1);
  }
  await startServer({
    retention,
    port: values.port ? Number(values.port) : undefined,
    host: values.host,
    db: values.db ? resolve(process.cwd(), values.db) : undefined,
    dev: values.dev,
  });
}
